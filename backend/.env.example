# API URL used by CLI commands (login, etc.)
ARBOR_API_URL=https://arbor-backend-qr7t.onrender.com

# Only needed if you run `arbor start` locally
PORT=3000
MONGODB_URL=mongodb://localhost:27017/arbor
JWT_SECREAT_KEY=your-secret-key

# Storage configuration (AWS S3 or Cloudflare R2)
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Set if using Cloudflare R2:
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
