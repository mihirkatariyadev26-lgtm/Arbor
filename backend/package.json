{
  "name": "arbor-cli",
  "version": "1.1.0",
  "description": "CLI for Arbor — version control with init, commit, push, pull, and login against the Arbor backend",
  "license": "ISC",
  "author": "Mihir Katariya <mihirkatariyadev26@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "controllers",
    "config",
    "middleware",
    "models",
    "routes",
    "index.js",
    "README.md"
  ],
  "main": "index.js",
  "bin": {
    "arbor": "bin/arbor.js"
  },
  "keywords": [
    "arbor",
    "cli",
    "git",
    "version-control",
    "repository"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihirkatariya/GIthub.git",
    "directory": "backend"
  },
  "scripts": {
    "start": "node index.js start",
    "prepublishOnly": "node --check index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fossil-delta": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "mongoose": "^9.2.3",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "yargs": "^17.7.2"
  }
}
